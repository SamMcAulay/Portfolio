---
import { projects, shellColor } from '../data/projects';
import Icon from './Icon.astro';

const featuredSlugs = ['teg-wardogs', 'phisher-vs-filter', 'ai-museum'];
const featured = featuredSlugs.map((s) => projects.find((p) => p.slug === s)!);

// Hero cards show only the top two stats so all three cards fit the first view.
const kicker: Record<string, string> = {
  'teg-wardogs': 'Live: 100,000+ unique visitors',
  'phisher-vs-filter': 'Thesis, approved and in progress',
  'ai-museum': 'Client work for Khora',
};

// Signposts fanned around the globe's rim. Angle in degrees, 180 = left, 270 = top.
// Signposts planted on the globe. Spread round the Earth so spinning it brings them into view.
const signs = [
  { label: 'About me', href: '#about', lat: 30, lon: -30, tone: 'butter' },
  { label: 'Projects', href: '#work', lat: 6, lon: 18, tone: 'blue' },
  { label: 'Experience', href: '#experience', lat: -6, lon: -36, tone: 'blush' },
  { label: 'Thesis', href: '/projects/phisher-vs-filter/', lat: 38, lon: 44, tone: 'mint' },
  { label: 'Contact', href: '#contact', lat: 54, lon: -64, tone: 'coral' },
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="intro">
    <h1 id="hero-title">Sam McAulay</h1>
    <p class="role">Software Developer, heading into AI &amp; Security</p>
    <p class="tagline">Building Digital Worlds.</p>
  </div>

  <div class="world">
    <div
      class="globe"
      data-globe
      tabindex="0"
      role="group"
      aria-label="A clay globe of the Earth with markers for each part of the site. Drag or use the arrow keys to turn it."
    >
      <img
        class="poster"
        src="/globe-poster.webp"
        alt=""
        width="1000"
        height="1000"
        fetchpriority="high"
        decoding="async"
      />
      <canvas aria-hidden="true"></canvas>
      <nav class="signs" aria-label="Explore the site">
        <ul>
          {
            signs.map((g) => (
              <li>
                <a class="sign" href={g.href} data-sign data-lat={g.lat} data-lon={g.lon} data-tone={g.tone}>
                  {g.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
    <p class="hint" aria-hidden="true">Spin the globe and pick a marker. The coral pin is Athlone, where I study and build.</p>
  </div>

  <div class="featured">
    <h2>Featured work</h2>
    <ul>
      {
        featured.map((p) => {
          const live = p.links.find((l) => l.kind === 'live') ?? p.links.find((l) => l.kind === 'repo');
          return (
            <li class="card clay" style={`--shell:${shellColor[p.shell]}`}>
              <div class="card-head">
                <span class="pebble" aria-hidden="true" data-vt-slug={p.slug} />
                <div>
                  <h3>
                    <a href={`/projects/${p.slug}/`} class="card-link">
                      {p.name}
                    </a>
                  </h3>
                  <p class="kicker">{kicker[p.slug]}</p>
                </div>
              </div>
              {p.stats && (
                <dl class="stats">
                  {p.stats.slice(0, 2).map((st) => (
                    <div>
                      <dt>{st.label}</dt>
                      <dd>{st.count}</dd>
                    </div>
                  ))}
                </dl>
              )}
              <p class="line">{p.line}</p>
              <p class="links">
                <a class="more" href={`/projects/${p.slug}/`}>
                  Read more <Icon name="arrow" />
                </a>
                {live && (
                  <a class="ext" href={live.href} target="_blank" rel="noopener">
                    {live.label} <Icon name="external" />
                  </a>
                )}
              </p>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<script>
  const host = document.querySelector<HTMLElement>('[data-globe]');
  if (host) {
    const start = async () => {
      // three.js loads after first paint; the poster image stands in until the globe is live.
      const { mountGlobe } = await import('../scripts/globe');
      mountGlobe(host);
    };
    if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 600 });
    else setTimeout(start, 50);
  }
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    grid-template-areas:
      'intro featured'
      'world featured';
    grid-template-rows: auto 1fr;
    gap: var(--s3) clamp(var(--s4), 5vw, var(--s6));
    max-width: 1440px;
    margin: 0 auto;
    padding: var(--s3) var(--gutter) var(--s6);
  }

  .intro {
    grid-area: intro;
    display: grid;
    gap: var(--s1);
  }

  h1 {
    font-size: clamp(3rem, 6.4vw, 5.6rem);
    line-height: 0.9;
  }

  .role {
    font-weight: 800;
    font-size: clamp(1.05rem, 1.5vw, 1.3rem);
  }

  .tagline {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(1.15rem, 1.6vw, 1.4rem);
    color: var(--ink-soft);
  }

  /* The globe and its signposts */
  .world {
    grid-area: world;
    position: relative;
    display: grid;
    justify-items: center;
    align-content: start;
    padding-top: var(--lead);
    container-type: inline-size;
    --size: min(100cqw, 520px, calc(100svh - 360px));
    --lead: var(--s4);
  }

  .globe {
    position: relative;
    width: var(--size);
    min-width: 260px;
    aspect-ratio: 1;
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    border-radius: 50%;
  }

  .globe.is-dragging {
    cursor: grabbing;
  }

  /* A soft contact shadow on the sky, as if the clay globe sits on a table. */
  .globe::after {
    content: '';
    position: absolute;
    left: 18%;
    right: 18%;
    bottom: -5%;
    height: 9%;
    border-radius: 50%;
    background: rgb(42 30 59 / 0.22);
    filter: blur(14px);
    z-index: -1;
  }

  .globe canvas,
  .poster {
    position: absolute;
    inset: -6%;
    width: 112%;
    height: 112%;
  }

  .globe canvas {
    opacity: 0;
  }

  .globe:global(.is-live) canvas {
    opacity: 1;
  }

  .globe:global(.is-live) .poster {
    visibility: hidden;
  }

  .globe:focus-visible {
    outline-offset: 10px;
    border-radius: 50%;
  }

  /* Signs. Without the live globe they sit in a plain row under it. */
  .signs {
    position: absolute;
    top: calc(100% + var(--s3));
    left: -10%;
    right: -10%;
  }

  .signs ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* With the live globe, each sign rides its post; the script sets its position and fade. */
  .globe:global(.is-live) .signs {
    inset: 0;
  }

  .globe:global(.is-live) .signs li {
    position: absolute;
    left: 0;
    top: 0;
    transform-origin: 50% 100%;
    will-change: transform, opacity;
  }

  .globe:global(.is-live) .signs li:global(.is-away) {
    pointer-events: none;
  }

  .sign {
    --tone: var(--paper);
    display: block;
    padding: 0.5em 1em 0.55em;
    border-radius: 999px;
    background: var(--tone);
    color: var(--ink);
    font-weight: 800;
    font-size: 0.98rem;
    line-height: 1.1;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: var(--lift-low);
    cursor: pointer;
    transition:
      translate 0.25s var(--out),
      box-shadow 0.25s var(--out);
  }

  .sign[data-tone='butter'] { --tone: var(--butter); }
  .sign[data-tone='blue'] { --tone: var(--blue); }
  .sign[data-tone='blush'] { --tone: var(--blush); }
  .sign[data-tone='mint'] { --tone: var(--mint); }
  .sign[data-tone='coral'] { --tone: var(--coral); }

  .sign:hover,
  .sign:focus-visible {
    translate: 0 -3px;
  }

  .sign:active {
    translate: 0 1px;
  }

  .world:has(:global(.is-live)) .hint {
    margin-top: var(--s4);
  }

  .hint {
    margin-top: var(--s6);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--ink-soft);
    text-align: center;
  }

  /* Featured work */
  .featured {
    grid-area: featured;
    align-self: center;
    display: grid;
    gap: var(--s2);
  }

  .featured h2 {
    font-family: var(--body);
    font-weight: 800;
    font-size: 1rem;
    letter-spacing: 0;
  }

  .featured ul {
    display: grid;
    gap: var(--s3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    position: relative;
    display: grid;
    gap: var(--s1);
    padding: var(--s3);
    /* Each featured slab is mixed from its project's clay colour. */
    --surface: color-mix(in oklab, var(--shell) 32%, var(--paper));
    transition: transform 0.3s var(--out);
  }

  .card:hover {
    transform: translateY(-3px);
  }

  .card-head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: var(--s2);
  }

  .card .pebble {
    width: 46px;
    aspect-ratio: 1;
  }

  h3 {
    font-size: 1.5rem;
    line-height: 1.05;
  }

  .card-link {
    text-decoration: none;
  }

  .card-link:hover {
    text-decoration: underline;
  }

  .kicker {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--ink-soft);
  }

  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s1) var(--s4);
    margin: 0;
  }

  .stats div {
    display: flex;
    flex-direction: column-reverse;
  }

  .stats dt {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--ink-soft);
  }

  .stats dd {
    margin: 0;
    font-family: var(--display);
    font-weight: 800;
    font-size: 2rem;
    line-height: 1;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .line {
    color: var(--ink-soft);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s1) var(--s3);
    margin-top: 2px;
    font-weight: 800;
    font-size: 0.95rem;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    text-decoration: none;
  }

  .links a:hover {
    text-decoration: underline;
  }

  .links :global(svg) {
    width: 1em;
    height: 1em;
  }

  .more {
    color: var(--coral-deep);
  }

  @media (max-width: 1100px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'intro' 'world' 'featured';
      grid-template-rows: auto;
      justify-items: stretch;
    }
    .intro {
      text-align: center;
      justify-items: center;
    }
    .world {
      --size: min(100cqw, 460px);
    }
    /* Tablets: the three cards sit in a compact row under the globe. */
    .featured ul {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--s2);
    }
    .card {
      padding: var(--s2);
      align-content: start;
    }
    .card-head {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s1);
    }
    .card .pebble {
      width: 34px;
    }
    h3 {
      font-size: 1.2rem;
    }
    .stats {
      gap: 4px var(--s2);
    }
    .stats dd {
      font-size: 1.45rem;
    }
    .line {
      font-size: 0.92rem;
      line-height: 1.45;
    }
    .links {
      font-size: 0.9rem;
    }
  }

  @media (max-width: 700px) {
    .featured ul {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s3);
    }
    .card {
      padding: var(--s3);
    }
    .card-head {
      grid-template-columns: auto minmax(0, 1fr);
      gap: var(--s2);
    }
    .card .pebble {
      width: 44px;
    }
    h3 {
      font-size: 1.45rem;
    }
    .stats dd {
      font-size: 1.9rem;
    }
    .line {
      font-size: 1rem;
    }
  }

  /* Short laptop screens: keep all three featured cards in the first view. */
  @media (min-width: 1101px) and (max-height: 820px) {
    .hero {
      padding-top: var(--s2);
    }
    h1 {
      font-size: clamp(2.8rem, 5vw, 4.4rem);
    }
    .featured ul {
      gap: var(--s2);
    }
    .card {
      padding: var(--s2) var(--s3);
      gap: 6px;
    }
    .card .pebble {
      width: 38px;
    }
    h3 {
      font-size: 1.3rem;
    }
    .stats dd {
      font-size: 1.6rem;
    }
    .line {
      font-size: 0.95rem;
      line-height: 1.45;
    }
  }

  /* Narrow screens: the signposts become a row of clay chips under the globe. */
  @media (max-width: 640px) {
    .world {
      --size: min(88cqw, 380px);
      --lead: var(--s3);
    }
    .sign {
      font-size: 0.88rem;
    }
  }
</style>
