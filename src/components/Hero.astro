---
import { projects, shellColor } from '../data/projects';
import Icon from './Icon.astro';

const featuredSlugs = ['teg-wardogs', 'phisher-vs-filter', 'ai-museum'];
const featured = featuredSlugs.map((s) => projects.find((p) => p.slug === s)!);

const kicker: Record<string, string> = {
  'teg-wardogs': 'Live community infrastructure',
  'phisher-vs-filter': 'Thesis, approved and in progress',
  'ai-museum': 'Client work for Khora',
};

// Signposts fanned around the globe's rim. Angle in degrees, 180 = left, 270 = top.
const posts = [
  { label: 'Projects', href: '#work', angle: 200 },
  { label: 'Thesis', href: '/projects/phisher-vs-filter/', angle: 226 },
  { label: 'Experience', href: '#experience', angle: 252 },
  { label: 'About', href: '#about', angle: 280 },
  { label: 'Contact', href: '#contact', angle: 310 },
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="intro">
    <h1 id="hero-title">Sam McAulay</h1>
    <p class="role">Software Developer, heading into AI &amp; Security</p>
    <p class="tagline">Building Digital Worlds.</p>
  </div>

  <div class="world">
    <div
      class="globe"
      data-globe
      tabindex="0"
      role="img"
      aria-label="A clay globe of the Earth with a pin on Athlone, Ireland. Drag or use the arrow keys to turn it."
    >
      <img
        class="poster"
        src="/globe-poster.webp"
        alt=""
        width="1000"
        height="1000"
        fetchpriority="high"
        decoding="async"
      />
      <canvas aria-hidden="true"></canvas>
    </div>
    <nav class="posts" aria-label="Explore the site">
      <ul>
        {
          posts.map((p, i) => (
            <li style={`--a:${p.angle}deg;--i:${i}`}>
              <a class="post" href={p.href} data-post>
                {p.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <p class="hint" aria-hidden="true">Drag to spin. That pin is Athlone, where I study and build.</p>
  </div>

  <div class="featured">
    <h2>Featured work</h2>
    <ul>
      {
        featured.map((p) => {
          const live = p.links.find((l) => l.kind === 'live') ?? p.links.find((l) => l.kind === 'repo');
          return (
            <li class="card clay" style={`--shell:${shellColor[p.shell]}`}>
              <div class="card-head">
                <span class="pebble" aria-hidden="true" data-vt-slug={p.slug} />
                <div>
                  <h3>
                    <a href={`/projects/${p.slug}/`} class="card-link">
                      {p.name}
                    </a>
                  </h3>
                  <p class="kicker">{kicker[p.slug]}</p>
                </div>
              </div>
              {p.stats && (
                <dl class="stats">
                  {p.stats.map((st) => (
                    <div>
                      <dt>{st.label}</dt>
                      <dd>{st.count}</dd>
                    </div>
                  ))}
                </dl>
              )}
              <p class="line">{p.line}</p>
              <p class="links">
                <a class="more" href={`/projects/${p.slug}/`}>
                  Read more <Icon name="arrow" />
                </a>
                {live && (
                  <a class="ext" href={live.href} target="_blank" rel="noopener">
                    {live.label} <Icon name="external" />
                  </a>
                )}
              </p>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<script>
  const host = document.querySelector<HTMLElement>('[data-globe]');
  if (host) {
    const start = async () => {
      // three.js loads after first paint; the poster image stands in until the globe is live.
      const { mountGlobe } = await import('../scripts/globe');
      const globe = mountGlobe(host);
      if (!globe) return;
      // Signposts to other pages ease the camera in before the page transition.
      for (const post of document.querySelectorAll<HTMLAnchorElement>('[data-post]')) {
        post.addEventListener('click', async (e) => {
          const href = post.getAttribute('href')!;
          if (href.startsWith('#') || e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
          e.preventDefault();
          await globe.dive();
          location.href = href;
        });
      }
    };
    if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 600 });
    else setTimeout(start, 50);
  }
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    grid-template-areas:
      'intro featured'
      'world featured';
    grid-template-rows: auto 1fr;
    gap: var(--s3) clamp(var(--s4), 5vw, var(--s6));
    max-width: 1440px;
    margin: 0 auto;
    padding: var(--s3) var(--gutter) var(--s6);
  }

  .intro {
    grid-area: intro;
    display: grid;
    gap: var(--s1);
  }

  h1 {
    font-size: clamp(3rem, 6.4vw, 5.6rem);
    line-height: 0.9;
  }

  .role {
    font-weight: 800;
    font-size: clamp(1.05rem, 1.5vw, 1.3rem);
  }

  .tagline {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(1.15rem, 1.6vw, 1.4rem);
    color: var(--ink-soft);
  }

  /* The globe and its signposts */
  .world {
    grid-area: world;
    position: relative;
    display: grid;
    justify-items: center;
    align-content: start;
    padding-top: var(--lead);
    container-type: inline-size;
    --size: min(100cqw, 520px, calc(100svh - 360px));
    --lead: 3.5rem;
  }

  .globe {
    position: relative;
    width: var(--size);
    min-width: 260px;
    aspect-ratio: 1;
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    border-radius: 50%;
  }

  .globe.is-dragging {
    cursor: grabbing;
  }

  /* A soft contact shadow on the sky, as if the clay globe sits on a table. */
  .globe::after {
    content: '';
    position: absolute;
    left: 18%;
    right: 18%;
    bottom: -5%;
    height: 9%;
    border-radius: 50%;
    background: rgb(30 42 68 / 0.22);
    filter: blur(14px);
    z-index: -1;
  }

  .globe canvas,
  .poster {
    position: absolute;
    inset: -6%;
    width: 112%;
    height: 112%;
  }

  .globe canvas {
    opacity: 0;
  }

  .globe:global(.is-live) canvas {
    opacity: 1;
  }

  .globe:global(.is-live) .poster {
    visibility: hidden;
  }

  .globe:focus-visible {
    outline-offset: 10px;
    border-radius: 50%;
  }

  .posts ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Wide screens: signposts fan around the upper-left rim of the globe. */
  .posts li {
    position: absolute;
    left: 50%;
    top: calc(var(--lead) + var(--size) / 2);
    transform:
      translate(-50%, -50%)
      rotate(var(--a))
      translateX(calc(var(--size) / 2 + 3.2rem))
      rotate(calc(-1 * var(--a)))
      rotate(calc((var(--i) - 2) * 3deg));
  }

  .post {
    display: block;
    padding: 0.55em 1.05em 0.6em;
    border-radius: 999px;
    background: var(--paper);
    color: var(--ink);
    font-weight: 800;
    font-size: 0.98rem;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: var(--lift-low);
    transition:
      transform 0.25s var(--out),
      background-color 0.25s var(--out);
  }

  .post:hover {
    background: var(--sand);
    transform: translateY(-2px);
  }

  .post:active {
    transform: translateY(1px);
  }

  .hint {
    margin-top: var(--s4);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--ink-soft);
    text-align: center;
  }

  /* Featured work */
  .featured {
    grid-area: featured;
    align-self: center;
    display: grid;
    gap: var(--s2);
  }

  .featured h2 {
    font-family: var(--body);
    font-weight: 800;
    font-size: 1rem;
    letter-spacing: 0;
  }

  .featured ul {
    display: grid;
    gap: var(--s3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    position: relative;
    display: grid;
    gap: var(--s1);
    padding: var(--s3);
    transition: transform 0.3s var(--out);
  }

  .card:hover {
    transform: translateY(-3px);
  }

  .card-head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: var(--s2);
  }

  .card .pebble {
    width: 46px;
    aspect-ratio: 1;
  }

  h3 {
    font-size: 1.5rem;
    line-height: 1.05;
  }

  .card-link {
    text-decoration: none;
  }

  .card-link:hover {
    text-decoration: underline;
  }

  .kicker {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--ink-soft);
  }

  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s1) var(--s4);
    margin: 0;
  }

  .stats div {
    display: flex;
    flex-direction: column-reverse;
  }

  .stats dt {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--ink-soft);
  }

  .stats dd {
    margin: 0;
    font-family: var(--display);
    font-weight: 800;
    font-size: 2rem;
    line-height: 1;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .line {
    color: var(--ink-soft);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s1) var(--s3);
    margin-top: 2px;
    font-weight: 800;
    font-size: 0.95rem;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    text-decoration: none;
  }

  .links a:hover {
    text-decoration: underline;
  }

  .links :global(svg) {
    width: 1em;
    height: 1em;
  }

  .more {
    color: var(--coral-deep);
  }

  @media (max-width: 1100px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'intro' 'world' 'featured';
      grid-template-rows: auto;
      justify-items: stretch;
    }
    .intro {
      text-align: center;
      justify-items: center;
    }
    .world {
      --size: min(100cqw, 460px);
    }
    /* Tablets: the three cards sit in a compact row under the globe. */
    .featured ul {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--s2);
    }
    .card {
      padding: var(--s2);
      align-content: start;
    }
    .card-head {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s1);
    }
    .card .pebble {
      width: 34px;
    }
    h3 {
      font-size: 1.2rem;
    }
    .stats {
      gap: 4px var(--s2);
    }
    .stats dd {
      font-size: 1.45rem;
    }
    .line {
      font-size: 0.92rem;
      line-height: 1.45;
    }
    .links {
      font-size: 0.9rem;
    }
  }

  @media (max-width: 700px) {
    .featured ul {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s3);
    }
    .card {
      padding: var(--s3);
    }
    .card-head {
      grid-template-columns: auto minmax(0, 1fr);
      gap: var(--s2);
    }
    .card .pebble {
      width: 44px;
    }
    h3 {
      font-size: 1.45rem;
    }
    .stats dd {
      font-size: 1.9rem;
    }
    .line {
      font-size: 1rem;
    }
  }

  /* Short laptop screens: keep all three featured cards in the first view. */
  @media (min-width: 1101px) and (max-height: 820px) {
    .hero {
      padding-top: var(--s2);
    }
    h1 {
      font-size: clamp(2.8rem, 5vw, 4.4rem);
    }
    .featured ul {
      gap: var(--s2);
    }
    .card {
      padding: var(--s2) var(--s3);
      gap: 6px;
    }
    .card .pebble {
      width: 38px;
    }
    h3 {
      font-size: 1.3rem;
    }
    .stats dd {
      font-size: 1.6rem;
    }
    .line {
      font-size: 0.95rem;
      line-height: 1.45;
    }
  }

  /* Narrow screens: the signposts become a row of clay chips under the globe. */
  @media (max-width: 640px) {
    .world {
      --size: min(88cqw, 380px);
      --lead: var(--s3);
    }
    .posts ul {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--s1);
      margin-top: var(--s4);
    }
    .posts li {
      position: static;
      transform: none;
    }
    .post {
      font-size: 0.92rem;
    }
    .hint {
      margin-top: var(--s2);
    }
  }
</style>
