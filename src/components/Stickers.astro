---
const groups = [
  { title: 'Languages', tone: 'butter', items: ['C', 'C++', 'C#', 'Java', 'Python', 'Lua', 'JavaScript', 'TypeScript', 'HTML', 'CSS', 'SQL', 'Bash'] },
  { title: 'Engines & libraries', tone: 'mint', items: ['Unity', 'SFML', 'Crow', 'Node.js', 'Next.js', 'React', 'Express', 'discord.js', 'Prisma', 'PostgreSQL', 'SQLite', 'Gemini API', 'HLSL', 'ShaderLab'] },
  { title: 'Tooling', tone: 'blue', items: ['Git', 'Docker', 'Cloudflare', 'Jenkins', 'CMake', 'AWS', 'Oracle', 'Neovim', 'Visual Studio', 'Blender'] },
  { title: 'Systems', tone: 'blush', items: ['Arch Linux', 'Debian', 'Ubuntu', 'FreeBSD', 'OpenBSD', 'Windows', 'i3wm', 'Wayland'] },
  { title: 'Off the clock', tone: 'paper', items: ['Making prototype perfumes', 'Vinyl and CD collecting', 'Building PCs and home servers', 'Watches and fashion'] },
];
---

<section class="parts" aria-labelledby="parts-title">
  <div class="parts-head">
    <h2 id="parts-title">Toolkit</h2>
    <p>What my projects are built with, and what I get up to away from them. Every tool here has shipped in a project or runs on my machine.</p>
  </div>

  <div class="groups">
    {
      groups.map((g) => (
        <div class="group" data-tone={g.tone}>
          <h3>{g.title}</h3>
          <ul>
            {g.items.map((item) => (
              <li class="chip">{item}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  .parts {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 var(--gutter) var(--s7);
  }

  .parts-head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: end;
    gap: var(--s2) var(--s5);
    margin-bottom: var(--s5);
  }

  h2 {
    font-size: clamp(2.6rem, 5.4vw, 4.4rem);
  }

  .parts-head p {
    font-weight: 700;
    max-width: 48ch;
    padding-bottom: var(--s1);
  }

  .groups {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s5) var(--s6);
  }

  h3 {
    font-family: var(--body);
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: 0;
    margin-bottom: var(--s2);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Clay chips: little pressed tiles in the group's colour. */
  .chip {
    --face: var(--butter);
    padding: 0.45em 1em 0.5em;
    border-radius: 999px;
    background: var(--face);
    color: var(--ink);
    font-weight: 800;
    font-size: 0.98rem;
    line-height: 1.1;
    box-shadow: var(--lift-low);
  }

  [data-tone='mint'] .chip { --face: var(--mint); }
  [data-tone='blue'] .chip { --face: var(--blue); }
  [data-tone='blush'] .chip { --face: var(--blush); }
  [data-tone='paper'] .chip { --face: var(--paper); }

  @media (max-width: 760px) {
    .parts-head,
    .groups {
      grid-template-columns: minmax(0, 1fr);
    }
    .groups {
      gap: var(--s4);
    }
    .chip {
      font-size: 0.92rem;
    }
  }
</style>
