---
import Icon from './Icon.astro';
---

<footer class="close" id="contact" aria-labelledby="close-title">
  <div class="inner">
    <h2 id="close-title">Have a role or project in mind?</h2>
    <p>I'm looking for developer roles, especially in AI and security. Email is the fastest way to reach me.</p>
    <a class="mail" href="mailto:SamMcAulay@pm.me">SamMcAulay@pm.me</a>
    <ul>
      <li>
        <a class="pill" data-tone="coral" href="mailto:SamMcAulay@pm.me"><Icon name="mail" /> Send an email</a>
      </li>
      <li>
        <a class="pill" href="https://github.com/SamMcAulay" rel="me noopener" target="_blank"><Icon name="github" /> GitHub</a>
      </li>
      <li>
        <a class="pill" href="https://www.linkedin.com/in/sammca05/" rel="me noopener" target="_blank"><Icon name="linkedin" /> LinkedIn</a>
      </li>
    </ul>
    <p class="small">© {new Date().getFullYear()} Sam McAulay. Built with Astro and three.js, hosted on GitHub Pages.</p>
  </div>
  <img class="earth" src="/globe-poster.webp" alt="" width="1000" height="1000" loading="lazy" decoding="async" />
</footer>

<style>
  /* The close is one big slab of ocean-coloured clay. */
  .close {
    position: relative;
    overflow: hidden;
    max-width: 1280px;
    margin: 0 auto var(--gutter);
    padding: var(--s6) clamp(var(--s3), 5vw, var(--s6)) var(--s4);
    background: var(--ocean);
    border-radius: 48px;
    box-shadow:
      inset 0 3px 0 rgb(255 255 255 / 0.35),
      inset 0 -14px 24px -10px rgb(30 42 68 / 0.18),
      0 24px 40px -24px rgb(30 42 68 / 0.45);
  }

  @media (max-width: 1360px) {
    .close {
      margin-inline: var(--gutter);
    }
  }

  .inner {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: start;
    gap: var(--s3);
  }

  h2 {
    font-size: clamp(2.4rem, 5.6vw, 4.6rem);
    max-width: 16ch;
  }

  p {
    max-width: 52ch;
    font-weight: 700;
  }

  .mail {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(1.5rem, 4.6vw, 3.4rem);
    line-height: 1.1;
    color: var(--ink);
    text-decoration: none;
    margin-top: var(--s1);
  }

  .mail:hover {
    text-decoration: underline;
    text-decoration-thickness: 4px;
    text-underline-offset: 0.15em;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
    margin: var(--s2) 0 var(--s6);
    padding: 0;
    list-style: none;
  }

  .small {
    font-size: 0.85rem;
  }

  /* The same clay Earth, resting in the corner of the slab. */
  .earth {
    position: absolute;
    right: -4%;
    bottom: -18%;
    width: min(40%, 460px);
    height: auto;
    pointer-events: none;
  }

  @media (max-width: 900px) {
    .earth {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .close {
      margin: 0 var(--s2) var(--s4);
      padding: var(--s5) var(--s3) var(--s4);
      border-radius: 36px;
    }
    h2 {
      font-size: 2rem;
    }
    .mail {
      font-size: 1.3rem;
    }
  }
</style>
