---
import Icon from './Icon.astro';

// Where the AI and security thread already runs through the work. Each points at a project.
const thread = [
  {
    name: 'Phisher vs Filter',
    line: 'My thesis: ML attackers against ML defenders, from hand-written rules up to a local LLM.',
    href: '/projects/phisher-vs-filter/',
    tone: 'butter',
  },
  {
    name: 'Moderation log bot',
    line: 'Flags players whose kill rate spikes far above their own record, live across six servers.',
    href: '/projects/teg-wardogs/',
    tone: 'blue',
  },
  {
    name: 'Warcon hosting',
    line: 'Zero-trust access through Cloudflare Access, with a scoped API key for each service.',
    href: '/projects/teg-wardogs/',
    tone: 'blue',
  },
  {
    name: 'AR AI Museum Guide',
    line: 'Live Gemini voice for a client, with answers grounded in search and keys kept off the phone.',
    href: '/projects/ai-museum/',
    tone: 'mint',
  },
  {
    name: 'Janguard',
    line: 'Steam sign-in, server-side sessions and staff verification for VIP access.',
    href: '/projects/janguard/',
    tone: 'blush',
  },
];
---

<section class="about" id="about" aria-labelledby="about-title">
  <div class="lead">
    <h2 id="about-title">Where I'm heading</h2>
    <div class="thread">
      <h3>AI and security in my work</h3>
      <ul>
        {
          thread.map((t) => (
            <li style={`--shell:var(--${t.tone})`}>
              <span class="dot pebble" aria-hidden="true" />
              <div>
                <a href={t.href}>{t.name}</a>
                <p>{t.line}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <div class="bio">
    <p>
      I'm Sam, a final-year student on TUS's BSc (Hons) in Software Design with Virtual Reality and Gaming,
      graduating in 2027. I'm on the Dean's Honours List and on course for a first.
    </p>
    <p>
      My work started in games and Discord bots, and it has been moving toward AI and security: I run the
      infrastructure for a 35,000-member gaming community, I built a live AI museum guide for a client, and my
      thesis measures whether AI helps phishers or spam filters more. That's the field I want to work in after I
      graduate.
    </p>
    <a class="pill cv" data-tone="coral" href="/SamMcAulay_CV.pdf" download="SamMcAulay_CV.pdf">
      <Icon name="download" /> Download my CV <span class="meta">PDF, 2 pages</span>
    </a>
  </div>
</section>

<style>
  .about {
    max-width: 1280px;
    margin: 0 auto;
    padding: var(--s6) var(--gutter) var(--s5);
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    align-items: start;
    gap: var(--s5) var(--s6);
  }

  .lead {
    display: grid;
    gap: var(--s4);
  }

  h2 {
    font-size: clamp(2.6rem, 5.4vw, 4.4rem);
  }

  .bio {
    display: grid;
    justify-items: start;
    gap: var(--s2);
    padding: var(--s4);
    background: var(--paper);
    border-radius: 32px;
    box-shadow: var(--lift);
    font-size: 1.15rem;
    font-weight: 700;
  }

  .cv {
    margin-top: var(--s1);
    font-size: 1rem;
  }

  .cv .meta {
    font-weight: 700;
    font-size: 0.85rem;
    opacity: 0.85;
  }

  h3 {
    font-family: var(--body);
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: 0;
    margin-bottom: var(--s2);
  }

  .thread ul {
    display: grid;
    gap: var(--s2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .thread li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: var(--s2);
  }

  .dot {
    width: 22px;
    aspect-ratio: 1;
    margin-top: 3px;
  }

  .thread a {
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.2rem;
    line-height: 1.2;
    text-decoration-thickness: 3px;
  }

  .thread p {
    color: var(--ink-soft);
    font-size: 0.98rem;
    max-width: 52ch;
  }

  @media (max-width: 860px) {
    .about {
      grid-template-columns: minmax(0, 1fr);
    }
    .bio {
      order: -1;
      grid-row: 2;
      padding: var(--s3);
      font-size: 1.05rem;
    }
    .lead {
      display: contents;
    }
    h2 {
      grid-row: 1;
    }
    .thread {
      grid-row: 3;
    }
  }
</style>
