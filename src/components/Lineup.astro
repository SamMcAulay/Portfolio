---
import { projects, shellColor, crewLabel } from '../data/projects';

// Width on a 12-column grid. Proof (user counts, the thesis) gets the most room; work in progress closes the set.
const span: Record<string, number> = {
  'teg-wardogs': 7,
  'phisher-vs-filter': 5,
  'ai-museum': 4,
  'jantleman-bot': 4,
  'flicker-bot': 4,
  janguard: 4,
  moonhaul: 4,
  'math-game': 4,
  'space-vr-explorer': 3,
  battleship: 3,
  'laser-game': 3,
  pangbot: 3,
  'i3-dotfiles': 3,
  'nvim-config': 3,
  ncwm: 6,
};
---

<section class="set" id="work" aria-labelledby="set-title">
  <header class="head">
    <h2 id="set-title">All projects</h2>
    <p>
      {projects.length} projects: my thesis, live community services, client work, bots with real users, games, and
      the Linux setup I work in every day. Open any one for the full write-up.
    </p>
  </header>

  <ol class="grid">
    {
      projects.map((p) => (
        <li
          class:list={['entry', { proof: !!p.stats, wip: p.crew === 'wip' }]}
          style={`--shell:${shellColor[p.shell]};--span:${span[p.slug] ?? 4}`}
        >
          <span class="pebble" aria-hidden="true" data-vt-slug={p.slug} />
          <div class="entry-body">
            <h3>
              <a href={`/projects/${p.slug}/`}>{p.name}</a>
            </h3>
            {p.stats && (
              <dl class="numerals">
                {p.stats.map((st) => (
                  <div>
                    <dt>{st.label}</dt>
                    <dd>{st.count}</dd>
                  </div>
                ))}
              </dl>
            )}
            <p class="line">{p.line}</p>
            {p.awards && (
              <ul class="awards" aria-label="Awards">
                {p.awards.map((a) => (
                  <li>{a}</li>
                ))}
              </ul>
            )}
            <p class="facts">
              <span class:list={['crew', p.crew]}>{crewLabel[p.crew]}</span>
              <span>{p.category}</span>
              {p.tech.map((t) => (
                <span>{t}</span>
              ))}
            </p>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .set {
    max-width: 1280px;
    margin: 0 auto;
    padding: var(--s5) var(--gutter) var(--s7);
  }

  .head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: end;
    gap: var(--s2) var(--s5);
    margin-bottom: var(--s5);
  }

  h2 {
    font-size: clamp(2.6rem, 5.4vw, 4.4rem);
  }

  .head p {
    font-weight: 700;
    max-width: 48ch;
    padding-bottom: var(--s1);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--s4) var(--s3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .entry {
    position: relative;
    grid-column: span var(--span);
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: var(--s2);
    padding: var(--s3);
    background: var(--paper);
    border-radius: 26px;
    box-shadow: var(--lift);
    transition: transform 0.3s var(--out);
  }

  .entry:hover,
  .entry:focus-within {
    transform: translateY(-4px);
  }

  .pebble {
    display: grid;
    place-items: center;
    width: 52px;
    aspect-ratio: 1;
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.05rem;
    line-height: 1;
    color: var(--ink);
  }

  .proof .pebble {
    width: 64px;
    font-size: 1.25rem;
  }

  .wip .pebble {
    background: transparent;
    box-shadow: inset 0 0 0 2.5px rgb(42 30 59 / 0.3);
  }

  .entry-body {
    display: grid;
    gap: var(--s1);
    min-width: 0;
  }

  h3 {
    font-size: clamp(1.35rem, 1.9vw, 1.6rem);
    line-height: 1.05;
  }

  h3 a {
    text-decoration: none;
  }

  /* The whole card is the link target. */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 26px;
  }

  h3 a:focus-visible {
    outline: none;
  }
  h3 a:focus-visible::after {
    outline: 3px solid var(--coral-deep);
    outline-offset: 5px;
  }

  .entry:hover h3 a {
    text-decoration: underline;
    text-decoration-thickness: 3px;
  }

  .line {
    color: var(--ink-soft);
    max-width: 44ch;
  }

  .numerals {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s1) var(--s4);
    margin: 0;
  }

  .numerals div {
    display: flex;
    flex-direction: column-reverse;
  }

  .numerals dt {
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  .numerals dd {
    margin: 0;
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(2.2rem, 3.6vw, 3.2rem);
    line-height: 0.95;
    font-variant-numeric: tabular-nums;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: var(--s1);
    font-size: 0.85rem;
    font-weight: 700;
  }

  .facts span {
    padding: 3px 11px 4px;
    border-radius: 999px;
    background: var(--cream);
    color: var(--ink-soft);
  }

  .facts .crew {
    background: var(--ink);
    color: var(--paper);
  }
  .facts .crew.team {
    background: var(--mint);
    color: var(--ink);
  }
  .facts .crew.wip,
  .facts .crew.thesis {
    background: var(--butter);
    color: var(--ink);
  }

  .awards {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 2px 0 0;
    padding: 0;
    list-style: none;
  }

  .awards li {
    padding: 3px 11px 4px;
    border-radius: 999px;
    background: var(--butter);
    font-size: 0.85rem;
    font-weight: 800;
    box-shadow: var(--lift-low);
  }

  @media (max-width: 1100px) {
    .entry {
      grid-column: span 6;
    }
    .entry.proof {
      grid-column: span 12;
    }
  }

  @media (max-width: 680px) {
    .head {
      grid-template-columns: minmax(0, 1fr);
    }
    .grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s3);
    }
    .entry,
    .entry.proof {
      grid-column: auto;
      padding: var(--s3) var(--s2);
    }
    .pebble {
      width: 44px;
      font-size: 0.95rem;
    }
    .proof .pebble {
      width: 52px;
      font-size: 1.05rem;
    }
  }
</style>
