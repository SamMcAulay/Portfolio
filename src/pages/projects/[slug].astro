---
import Base from '../../layouts/Base.astro';
import Close from '../../components/Close.astro';
import Icon from '../../components/Icon.astro';
import { projects, shellColor, crewLabel, type Project } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

interface Props {
  project: Project;
  next: Project;
}

const { project: p, next } = Astro.props;
const linkIcon = { repo: 'github', live: 'external', invite: 'discord' } as const;
const tone = { repo: 'ink', live: 'coral', invite: 'mint' } as const;
---

<Base title={`${p.name} | Sam McAulay`} description={`${p.line} ${p.tech.join(', ')}.`}>
  <article style={`--shell:${shellColor[p.shell]}`} class:list={{ wip: p.crew === 'wip' }}>
    <header class="hero">
      <div class="badge pebble" aria-hidden="true"></div>

      <div class="title">
        <h1>{p.name}</h1>
        <p class="line">{p.line}</p>
        <p class="facts">
          <span class:list={['crew', p.crew]}>{crewLabel[p.crew]}</span>
          <span>{p.category}</span>
        </p>
        {
          p.links.length > 0 && (
            <ul class="links">
              {p.links.map((l) => (
                <li>
                  <a class="pill" data-tone={tone[l.kind]} href={l.href} target="_blank" rel="noopener">
                    <Icon name={linkIcon[l.kind]} />
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </header>

    <section class="sheet" aria-label="About this project">
      {
        p.stats && (
          <div class="numerals">
            {p.stats.map((st) => (
              <p class="numeral">
                <span class="big">{st.count}</span>
                <span>{st.label}</span>
              </p>
            ))}
          </div>
        )
      }
      <div class="prose">
        {p.body.map((para) => <p>{para}</p>)}
        {p.crewNote && <p class="note">{p.crewNote}.</p>}
      </div>
      {
        p.awards && (
          <div class="awards">
            <h2>Awards</h2>
            <ul>
              {p.awards.map((a) => (
                <li>{a}</li>
              ))}
            </ul>
          </div>
        )
      }
      {
        p.parts && (
          <div class="parts">
            <h2>What's in it</h2>
            <ul>
              {p.parts.map((part) => (
                <li>
                  <h3>
                    {part.href ? (
                      <a href={part.href} target="_blank" rel="noopener">
                        {part.name}
                        <Icon name="external" />
                      </a>
                    ) : (
                      part.name
                    )}
                  </h3>
                  <p>{part.line}</p>
                </li>
              ))}
            </ul>
          </div>
        )
      }
      <div class="built">
        <h2>Built with</h2>
        <ul>
          {p.tech.map((t) => <li>{t}</li>)}
        </ul>
      </div>
    </section>

    {
      p.images.length > 0 && (
        <section class="shots" aria-label="Screenshots">
          <ul>
            {p.images.map((src, i) => (
              <li>
                <a href={src} target="_blank" rel="noopener">
                  <img src={src} alt={`${p.name} screenshot ${i + 1} of ${p.images.length}`} loading="lazy" decoding="async" />
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <nav class="next" aria-label="More projects">
      <a class="pill" href={`/projects/${next.slug}/`} data-tone="coral">
        Next project: {next.name} <Icon name="arrow" />
      </a>
      <a class="pill" href="/#work">All projects</a>
    </nav>
  </article>
  <Close />
</Base>

<style>
  article {
    max-width: 1280px;
    margin: 0 auto;
    padding: var(--s4) var(--gutter) var(--s7);
  }

  .hero {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: var(--s3);
    padding-top: var(--s5);
    margin-bottom: var(--s6);
  }

  /* The project's clay pebble, the same one that sat on the home page, grown large. */
  .badge {
    view-transition-name: project-pebble;
    align-self: start;
    width: clamp(56px, 6vw, 84px);
    aspect-ratio: 1;
    margin-top: 0.6rem;
  }

  .title {
    display: grid;
    gap: var(--s2);
    justify-items: start;
  }

  h1 {
    font-size: clamp(2.8rem, 6.4vw, 5.4rem);
    line-height: 0.95;
  }

  .line {
    font-size: clamp(1.1rem, 1.6vw, 1.3rem);
    font-weight: 700;
    max-width: 40ch;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 0.9rem;
    font-weight: 800;
  }

  .facts span {
    padding: 4px 12px 5px;
    border-radius: 999px;
    background: var(--paper);
    box-shadow: var(--lift-low);
  }
  .facts .crew {
    background: var(--ink);
    color: var(--paper);
  }
  .facts .crew.team {
    background: var(--mint);
    color: var(--ink);
  }
  .facts .crew.wip,
  .facts .crew.thesis {
    background: var(--butter);
    color: var(--ink);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
    margin: var(--s1) 0 0;
    padding: 0;
    list-style: none;
  }

  .sheet {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    grid-template-areas: 'num num' 'prose built';
    gap: var(--s4) var(--s6);
    padding: clamp(var(--s4), 5vw, var(--s6));
    background: var(--paper);
    border-radius: 40px;
    box-shadow: var(--lift);
  }

  .sheet:not(:has(.numeral)) {
    grid-template-areas: 'prose built';
  }

  .numerals {
    grid-area: num;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2) var(--s6);
  }

  .numeral {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0 var(--s2);
    font-weight: 800;
    font-size: 1.2rem;
  }

  .numeral .big {
    font-family: var(--display);
    font-size: clamp(3.6rem, 9vw, 7rem);
    line-height: 0.9;
    font-variant-numeric: tabular-nums;
  }

  .prose {
    grid-area: prose;
    display: grid;
    gap: var(--s2);
    font-size: 1.12rem;
    max-width: 62ch;
  }

  .note {
    color: var(--ink-soft);
    font-size: 0.98rem;
    font-weight: 700;
  }

  .built {
    grid-area: built;
  }

  h2 {
    font-family: var(--body);
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: 0;
    margin-bottom: var(--s2);
  }

  .built ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .built li {
    padding: 0.4em 0.95em 0.45em;
    border-radius: 999px;
    background: var(--shell);
    font-weight: 800;
    box-shadow: var(--lift-low);
  }

  .wip .built li {
    background: var(--butter);
  }

  .awards {
    grid-column: 1 / -1;
  }

  .awards ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .awards li {
    padding: 0.45em 1.15em 0.55em;
    border-radius: 999px;
    background: var(--butter);
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.25rem;
    box-shadow: var(--lift-low);
  }

  .parts {
    grid-column: 1 / -1;
    padding-top: var(--s4);
    border-top: 2px solid var(--cream);
  }

  .parts ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s4) var(--s5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .parts h3 {
    font-size: 1.35rem;
    line-height: 1.1;
    margin-bottom: var(--s1);
  }

  .parts h3 a {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
  }

  .parts h3 :global(svg) {
    width: 0.8em;
    height: 0.8em;
    flex: none;
  }

  .parts p {
    color: var(--ink-soft);
    max-width: 48ch;
  }

  .shots {
    margin-top: var(--s6);
  }

  .shots ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .shots a {
    display: block;
    padding: 10px;
    background: var(--paper);
    border-radius: 24px;
    box-shadow: var(--lift);
    transition: transform 0.3s var(--out);
  }

  .shots a:hover {
    transform: translateY(-4px);
  }

  .shots img {
    width: 100%;
    height: auto;
    border-radius: 14px;
  }

  .next {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
    margin-top: var(--s6);
  }

  @media (max-width: 860px) {
    .hero {
      gap: var(--s2);
      padding-top: var(--s4);
    }
    .badge {
      width: 48px;
      margin-top: 0.3rem;
    }
    .sheet {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'num' 'prose' 'built';
    }
    .sheet:not(:has(.numeral)) {
      grid-template-areas: 'prose' 'built';
    }
    .parts ul,
    .shots ul {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
