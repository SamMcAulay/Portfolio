---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base home title="Empty capsule | Sam McAulay" description="This page doesn't exist. Head back to the machine to see Sam McAulay's projects.">
  <section class="empty" aria-labelledby="empty-title">
    <div class="shell" aria-hidden="true">
      <span class="half top"></span>
      <span class="half bottom"></span>
    </div>
    <h1 id="empty-title" class="lettering">This capsule's empty</h1>
    <p>There's nothing at this address. It may have moved when the site was rebuilt.</p>
    <a class="pill" data-tone="lemon" href="/">
      <Icon name="back" /> Back to the machine
    </a>
  </section>
</Base>

<style>
  .empty {
    display: grid;
    justify-items: center;
    gap: var(--s3);
    min-height: calc(100svh - 120px);
    align-content: center;
    padding: var(--s5) var(--gutter) var(--s7);
    text-align: center;
  }

  .shell {
    position: relative;
    width: min(56vw, 220px);
    aspect-ratio: 1 / 1.1;
    margin-bottom: var(--s2);
  }

  .half {
    position: absolute;
    left: 0;
    width: 100%;
    height: 46%;
    border: 4px dashed var(--ink);
  }

  .half.top {
    top: 0;
    border-radius: 999px 999px 0 0;
    background:
      radial-gradient(circle at 28% 40%, rgb(255 255 255 / 0.85) 0 8%, transparent 9%),
      var(--shell-white);
    transform-origin: 8% 100%;
    transform: translateY(-10%) rotate(-28deg);
  }

  .half.bottom {
    bottom: 0;
    border-radius: 0 0 999px 999px;
    background: rgb(255 255 255 / 0.7);
  }

  h1 {
    font-size: clamp(2.6rem, 8vw, 5rem);
    transform: rotate(-2deg);
  }

  p {
    max-width: 40ch;
    font-weight: 700;
  }
</style>
