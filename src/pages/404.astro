---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base home title="Off the map | Sam McAulay" description="This page doesn't exist. Head back home to see Sam McAulay's projects.">
  <section class="empty" aria-labelledby="empty-title">
    <div class="pebble lost" aria-hidden="true"><span>?</span></div>
    <h1 id="empty-title">This page is off the map</h1>
    <p>There's nothing at this address. It may have moved when the site was rebuilt.</p>
    <a class="pill" data-tone="coral" href="/">
      <Icon name="back" /> Back home
    </a>
  </section>
</Base>

<style>
  .empty {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: var(--s3);
    min-height: calc(100svh - 120px);
    padding: var(--s5) var(--gutter) var(--s7);
    text-align: center;
  }

  .lost {
    --shell: var(--sand);
    display: grid;
    place-items: center;
    width: min(44vw, 180px);
    aspect-ratio: 1;
    margin-bottom: var(--s2);
    font-family: var(--display);
    font-weight: 800;
    font-size: 4.5rem;
    color: var(--ink);
  }

  h1 {
    font-size: clamp(2.4rem, 7vw, 4.6rem);
  }

  p {
    max-width: 40ch;
    font-weight: 700;
  }
</style>
