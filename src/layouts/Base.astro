---
import '@fontsource/baloo-2/700.css';
import '@fontsource/baloo-2/800.css';
import '@fontsource/m-plus-rounded-1c/500.css';
import '@fontsource/m-plus-rounded-1c/700.css';
import '@fontsource/m-plus-rounded-1c/800.css';
import '../styles/global.css';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  description: string;
  home?: boolean;
}

const { title, description, home = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#dce9f5" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Sam McAulay's portfolio: a clay globe of the Earth beside his featured projects." />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {home && <link rel="preload" as="image" href="/globe-poster.webp" fetchpriority="high" />}
    <script is:inline>
      // Name the project's pebble that morphs into (or out of) a project page during a view transition.
      (() => {
        const slugOf = (url) => url && new URL(url).pathname.match(/^\/projects\/([^/]+)/)?.[1];
        const pick = (slug) => {
          const all = [...document.querySelectorAll(`[data-vt-slug="${slug}"]`)];
          return all.find((el) => {
            const r = el.getBoundingClientRect();
            return r.bottom > 0 && r.top < innerHeight;
          });
        };
        addEventListener('pageswap', (e) => {
          if (!e.viewTransition) return;
          e.viewTransition.ready.catch(() => {});
          e.viewTransition.finished.catch(() => {});
          const el = pick(slugOf(e.activation?.entry?.url));
          if (el) el.style.viewTransitionName = 'project-pebble';
        });
        addEventListener('pagereveal', (e) => {
          if (!e.viewTransition) return;
          e.viewTransition.ready.catch(() => {});
          e.viewTransition.updateCallbackDone?.catch?.(() => {});
          const el = pick(slugOf(navigation.activation?.from?.url));
          if (!el) return;
          el.style.viewTransitionName = 'project-pebble';
          const clear = () => (el.style.viewTransitionName = '');
          e.viewTransition.finished.then(clear, clear);
        });
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="topbar">
      {
        home ? (
          <span class="domain">sammcaulay.dev</span>
        ) : (
          <a class="pill back" href="/" aria-label="Back home">
            <Icon name="back" />
            Home
          </a>
        )
      }
      <nav aria-label="Contact">
        <ul>
          <li>
            <a class="chip" href="https://github.com/SamMcAulay" rel="me noopener" target="_blank">
              <Icon name="github" /><span class="label">GitHub</span>
            </a>
          </li>
          <li>
            <a class="chip" href="https://www.linkedin.com/in/sammca05/" rel="me noopener" target="_blank">
              <Icon name="linkedin" /><span class="label">LinkedIn</span>
            </a>
          </li>
          <li>
            <a class="chip email" href="mailto:SamMcAulay@pm.me">
              <Icon name="mail" /><span class="label">Email me</span>
            </a>
          </li>
        </ul>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
  </body>
</html>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }
  }

  .skip {
    position: absolute;
    left: var(--gutter);
    top: -4rem;
    z-index: 100;
    padding: var(--s1) var(--s2);
    background: var(--ink);
    color: var(--paper);
    border-radius: 999px;
    font-weight: 800;
  }
  .skip:focus {
    top: var(--s2);
  }

  .topbar {
    position: relative;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s2);
    padding: var(--s3) var(--gutter) 0;
    max-width: 1440px;
    margin: 0 auto;
    view-transition-name: topbar;
  }

  .domain {
    font: 800 0.95rem/1 var(--body);
    color: var(--ink);
    letter-spacing: 0.02em;
  }

  nav ul {
    display: flex;
    gap: var(--s1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.6em 1.05em 0.65em;
    border-radius: 999px;
    background: var(--paper);
    color: var(--ink);
    font: 800 0.95rem/1 var(--body);
    white-space: nowrap;
    text-decoration: none;
    box-shadow: var(--lift-low);
    transition:
      transform 0.2s var(--out),
      background-color 0.2s var(--out);
  }

  .chip:hover {
    transform: translateY(-2px);
    background: var(--sand);
  }

  .chip:active {
    transform: translateY(1px);
  }

  .chip.email {
    background: var(--coral);
  }

  .chip.email:hover {
    background: #f19484;
  }

  .chip :global(svg) {
    width: 1.15em;
    height: 1.15em;
    flex: none;
  }

  .back {
    font-size: 0.95rem;
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
    .chip {
      padding: 0.65em;
    }
    .back {
      font-size: 0.88rem;
    }
    .domain {
      font-size: 0.85rem;
    }
  }
</style>
